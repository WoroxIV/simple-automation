{
 "multipart": [
  {
   "apply": {
    "model": "simple_automation:block/pipe_core"
   }
  },
  {
   "when": {
    "north": "pipe|insert|extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_arm"
   }
  },
  {
   "when": {
    "north": "insert"
   },
   "apply": {
    "model": "simple_automation:block/pipe_insert"
   }
  },
  {
   "when": {
    "north": "extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_extract"
   }
  },
  {
   "when": {
    "east": "pipe|insert|extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_arm",
    "y": 90
   }
  },
  {
   "when": {
    "east": "insert"
   },
   "apply": {
    "model": "simple_automation:block/pipe_insert",
    "y": 90
   }
  },
  {
   "when": {
    "east": "extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_extract",
    "y": 90
   }
  },
  {
   "when": {
    "south": "pipe|insert|extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_arm",
    "y": 180
   }
  },
  {
   "when": {
    "south": "insert"
   },
   "apply": {
    "model": "simple_automation:block/pipe_insert",
    "y": 180
   }
  },
  {
   "when": {
    "south": "extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_extract",
    "y": 180
   }
  },
  {
   "when": {
    "west": "pipe|insert|extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_arm",
    "y": 270
   }
  },
  {
   "when": {
    "west": "insert"
   },
   "apply": {
    "model": "simple_automation:block/pipe_insert",
    "y": 270
   }
  },
  {
   "when": {
    "west": "extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_extract",
    "y": 270
   }
  },
  {
   "when": {
    "up": "pipe|insert|extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_arm",
    "x": 270
   }
  },
  {
   "when": {
    "up": "insert"
   },
   "apply": {
    "model": "simple_automation:block/pipe_insert",
    "x": 270
   }
  },
  {
   "when": {
    "up": "extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_extract",
    "x": 270
   }
  },
  {
   "when": {
    "down": "pipe|insert|extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_arm",
    "x": 90
   }
  },
  {
   "when": {
    "down": "insert"
   },
   "apply": {
    "model": "simple_automation:block/pipe_insert",
    "x": 90
   }
  },
  {
   "when": {
    "down": "extract"
   },
   "apply": {
    "model": "simple_automation:block/pipe_extract",
    "x": 90
   }
  }
 ]
}